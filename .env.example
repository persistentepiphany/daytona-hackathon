# Control plane
DATABASE_URL=postgresql+psycopg://user:password@host:5432/snapshot
REDIS_URL=redis://default:password@host:6379/0
API_TOKEN=replace-with-a-generated-random-value
ALLOWED_ORIGINS=https://your-vercel-preview.example
ARXIV_USER_AGENT=Snapshot-Reproduction/1.0 your-contact@example.com

# Private S3-compatible object storage
S3_ENDPOINT_URL=https://your-s3-compatible-endpoint.example
S3_REGION=auto
S3_BUCKET=snapshot-artifacts
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me

# Pipeline providers
DAYTONA_API_KEY=replace-me
ZAI_API_KEY=replace-me
PARALLEL_API_KEY=replace-me

# GitHub App user access token. The app needs Administration:write and Contents:write.
GITHUB_OWNER=persistentepiphany
GITHUB_USER_TOKEN=replace-me
